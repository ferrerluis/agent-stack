# Terraform state — never commit these
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform plans — can embed full configuration and plaintext secrets
tfplan
*.tfplan
*.tfplan.*

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Local diagnostic and configuration backups
.tmp/

# Variable files may contain secrets — use terraform.tfvars.example as the template
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Crash and debug logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Repo-local SSH assets (generated by bin/agent-stack-ssh-create)
# .ssh/config is generated by `terraform apply` (local_file.repo_ssh_config)
/.ssh/*
!/.ssh/config.example

# Editor / OS artifacts
.DS_Store
.idea/
*.swp
*.swo

# Local operator notes
/CODEX.md

# Claude Code working directory
.claude/

# Private showcase input, reservation, state and recovery records
/.showcase-runs/
/showcase-inputs.json
