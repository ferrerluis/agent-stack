# ═══════════════════════════════════════════════════════════════
# AgentStack Terraform — variable example file
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars (it is in .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Provider selection ──────────────────────────────────────────
# "aws" → deploys an EC2 instance
# "digitalocean" → deploys a Droplet
# "hetzner" → deploys a Hetzner Cloud server
cloud_provider = "aws"

project_name = "agent-stack"

# Standard SSH/admin username created on the VM across providers.
admin_username = "admin"

# Optional host admin password login for the sudo-capable VM user.
# Blank + disabled keeps the host admin password locked and key-only.
# "tailnet" allows SSH password auth only when the connection reaches sshd from
# a Tailscale source address; this requires tailscale_enabled=true and tailscale_mode="host".
# "public" allows SSH password auth on the normal provider-firewall SSH path;
# Terraform rejects public password scope when allowed_ssh_cidr is 0.0.0.0/0.
admin_password           = ""
admin_password_ssh_scope = "disabled" # disabled | tailnet | public

# Install Codex CLI on the VM host for sudo-capable admin troubleshooting.
# Auth is created on the host after apply with:
#   terraform output -raw host_codex_login_command
host_codex_cli_enabled = true

# ── AWS ─────────────────────────────────────────────────────────
# Leave blank if deploying to DigitalOcean.
# Alternatively, omit these and rely on the AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY environment variables or an IAM role.

aws_region     = "us-east-1"
aws_access_key = "YOUR_AWS_ACCESS_KEY_ID"
aws_secret_key = "YOUR_AWS_SECRET_ACCESS_KEY"

# Instance size — t3.small = 1 vCPU / 2 GB RAM (default)
# Upgrade examples: t3.medium (2/4 GB), t3.large (2/8 GB)
aws_instance_type = "t3.small"

# EBS data volume size in GB (default 50 GB, separate from 20 GB OS disk)
aws_disk_size_gb = 50

# Leave blank to create a fresh EBS volume.
# Set to an existing volume ID (e.g. "vol-0abc123def456789") to reuse it.
aws_existing_volume_id = ""

# ── DigitalOcean ─────────────────────────────────────────────────
# Leave blank if deploying to AWS.

do_token  = "YOUR_DIGITALOCEAN_API_TOKEN"
do_region = "nyc3" # Other options: sfo3, fra1, lon1, sgp1, etc.

# Droplet size — s-2vcpu-2gb = 2 vCPU / 2 GB RAM / 60 GB root disk (default)
# Upgrade examples: s-2vcpu-4gb (4 GB), s-4vcpu-8gb (8 GB)
do_droplet_size = "s-2vcpu-2gb"

# Extra block storage volume in GB (default 20 GB — root disk is already 60 GB)
do_disk_size_gb = 20

# Leave blank to create a new volume.
# To reuse an existing volume, set BOTH fields:
do_existing_volume_id   = ""
do_existing_volume_name = ""

# ── Hetzner Cloud ────────────────────────────────────────────────
# Leave blank if deploying to AWS or DigitalOcean.

hcloud_token       = "YOUR_HETZNER_CLOUD_API_TOKEN"
hcloud_location    = "ash"
hcloud_server_type = "cpx21" # sized for the full AgentStack profile
hcloud_image       = "ubuntu-22.04"

# Extra block storage volume in GB (default 50 GB)
hcloud_disk_size_gb = 50

# Leave blank to create a new volume.
hcloud_existing_volume_id = ""

# ── SSH ──────────────────────────────────────────────────────────
# Optional explicit SSH public key.
# If empty, Terraform auto-resolves/creates ./.ssh/id_ed25519_agent_stack(.pub)
# at plan/apply time and uses that public key.
ssh_public_key = ""

# Repo-relative key path used for auto key resolution/generation (when
# ssh_public_key is empty).
repo_ssh_private_key_path = ".ssh/id_ed25519_agent_stack"

# Write ./.ssh/config with resolved host/user/key on apply
generate_repo_ssh_config = true
repo_ssh_host_alias      = "agent-stack"
repo_ssh_identity_file   = "./.ssh/id_ed25519_agent_stack"

# Restrict SSH to your own IP for best security: "203.0.113.5/32"
# Leave as 0.0.0.0/0 only when host admin password SSH remains disabled.
allowed_ssh_cidr = "0.0.0.0/0"

# ── LLM credentials ───────────────────────────────────────────────
# Supply only the credentials for the providers you intend to use in AgentStack.
# Unused keys/auth payloads can be left as empty strings.

anthropic_api_key  = "sk-ant-api03-..."  # Claude (Opus, Sonnet, Haiku) — pay-per-token
anthropic_auth_key = ""                  # Legacy Anthropic setup-token path; leave blank unless you explicitly need it
openai_api_key     = "sk-..."            # GPT-4o, o3, etc. via the OpenAI API
openai_codex_auth_json_base64 = ""       # Base64 of ~/.codex/auth.json for openai_auth_mode="codex"
groq_api_key       = ""                 # e.g. gsk_...  (Llama, Mixtral via Groq)
gemini_api_key     = ""                 # e.g. AIzaSy...

# Optional: Telegram bot token from BotFather to preconfigure channels.telegram.botToken at bootstrap.
telegram_bot_token = ""                 # e.g. 123456789:AA...

# Optional: Pre-approved Telegram user IDs (strings) for channels.telegram.allowFrom.
# Keep dmPolicy="pairing" to require pairing for everyone else.
telegram_allow_from = [
  # "1234567890",
]

# Bootstrap config behavior:
# - auto: preserve existing openclaw.json on reused volumes, manage fresh installs
# - manage: always apply starter channel/model bootstrap updates
# - preserve: skip optional channel/model bootstrap updates
openclaw_config_mode = "auto"

# Primary channel plugin to bootstrap.
agent_channel = "telegram" # "telegram" or "whatsapp"

# REQUIRED: explicitly choose model providers + model routing.
# Terraform apply will fail if these are omitted.
model_providers_enabled = [
  "anthropic",
  "google",
]
# OpenAI auth mode for openai/* models:
# - api_key: use openai_api_key for direct OpenAI Platform billing
# - codex: use openai_codex_auth_json_base64 for ChatGPT subscription-backed Codex auth
# ChatGPT subscription-backed example:
#   model_providers_enabled = ["openai"]
#   openai_auth_mode = "codex"
#   default_model = "openai/gpt-5.5"
#   fallback_models = ["openai/gpt-5.4-mini"]
openai_auth_mode = "api_key"
default_model = "anthropic/claude-haiku-4-5"
fallback_models = [
  "google/gemini-3-flash-preview",
  "anthropic/claude-sonnet-4-6",
]

# OpenClaw image tag — pin to a specific version for reproducibility
openclaw_version = "latest"

# Optional Node.js runtime flags for OpenClaw container.
# Keep a memory cap on small instances to avoid startup OOM on newer builds.
openclaw_node_options = "--max-old-space-size=1536"

# Seed starter workspace files into /home/node/.openclaw/workspace (create-if-missing).
seed_starter_workspace_files = true
starter_soul_profile         = "balanced" # balanced | builder | researcher

# Optional: set a fixed gateway token. Leave blank to auto-generate one that
# Terraform stores in state and prints in outputs.
gateway_token = ""

# ── Agent + automation stack ─────────────────────────────────────
# Default: run the complete local stack.
enabled_services = [
  "openclaw",
  "hermes",
  "n8n",
  # "workspace",
]

# Optional Codex workspace container. Add "workspace" above to enable.
# Password is used only for SSH into the workspace container over Tailscale.
workspace_codex_release             = "0.145.0" # pinned CLI release baked into the workspace image
# Opt in only after the first approved workspace rollout. This requires the
# pinned fallback above to be a stable x.y.z release. It checks the stable
# channel only at the configured daily cutover (never at startup or after an
# idle wait) and may interrupt active Codex work when a new CLI release
# requires an app-server restart. Technical retries are +5, +15, and +35
# minutes after the configured cutover (04:05, 04:15, and 04:35 by default).
workspace_codex_auto_update_enabled = false
workspace_codex_auto_update_timezone = "America/New_York"
workspace_codex_auto_update_time     = "04:00"
# Leave false for the first approved rollout. Enable only in a second targeted
# approved apply after the root-admin-only disposable-thread desktop E2E probe
# proves safe interrupted-turn recovery.
workspace_codex_auto_recover_interrupted_turns = false
workspace_username                  = "user"
workspace_password                  = ""
# Automated runs may supply this instead of the plaintext password. Keep it private.
workspace_password_hash             = ""
workspace_ssh_host_port             = 2222
workspace_ssh_public_keys = [
  # "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly user@example.com",
]

# Workspace knowledge uses the bundled para-memory-drive skill and the agent's
# connected Google Drive capability. Do not configure a Drive filesystem mount,
# rclone credentials, or FUSE settings in this file.

# ── Optional host VPN egress ────────────────────────────────────
# Routes host + Docker service egress through a VPN tunnel after provisioning.
# Keep nordvpn_openvpn for the backward-compatible manual client, or select
# nordvpn_nordlynx to use Nord's native Linux app and WireGuard-based tunnel.
# Do not use your normal Nord account email/password for either backend.
#
# OpenVPN: use manual service credentials and pick a specific .ovpn URL from:
# https://downloads.nordcdn.com/configs/archives/servers/ovpn.zip
# NordLynx: generate a non-expiring access token in Nord Account and store it
# only in the sensitive vpn_nordvpn_token input. United_States selects Nord's
# recommended US server rather than pinning one hostname.
#
# You must include at least one public/admin fallback CIDR. Never add the
# Tailscale 100.64.0.0/10 range here; the VPN manager preserves it separately.
vpn_enabled                = false
vpn_provider               = "nordvpn_openvpn"
vpn_nordvpn_token          = ""
vpn_nordvpn_connect_target = ""
vpn_openvpn_config_url     = ""
vpn_username               = ""
vpn_password               = ""
vpn_bypass_cidrs = [
  # "203.0.113.5/32", # your current admin IP for public SSH
]
vpn_disable_ipv6    = true
vpn_healthcheck_url = "https://api.ipify.org"

# Hermes Agent runtime.
hermes_image              = "nousresearch/hermes-agent:latest"
hermes_dashboard_enabled  = true
hermes_api_server_enabled = true
hermes_api_server_key     = "" # blank = Terraform auto-generates

# n8n runtime.
n8n_image                   = "docker.n8n.io/n8nio/n8n:stable"
n8n_database_mode           = "local_postgres" # local_postgres | external_postgres
n8n_encryption_key          = ""               # blank = Terraform auto-generates
n8n_public_webhooks_enabled = true
n8n_generic_timezone        = "America/New_York"

# Local Postgres for n8n. Data is stored on the persistent volume.
postgres_image    = "postgres:17-alpine"
postgres_database = "n8n"
postgres_user     = "n8n"
postgres_password = "" # blank = Terraform auto-generates

# External Postgres, used only when n8n_database_mode = "external_postgres".
external_postgres_host        = ""
external_postgres_port        = 5432
external_postgres_database    = "n8n"
external_postgres_user        = "n8n"
external_postgres_password    = ""
external_postgres_ssl_enabled = true

# ── Optional public domains + login gate ─────────────────────────
# When disabled, UI ports stay bound to localhost and are reached through
# Tailscale or SSH tunnels.
public_domain_enabled = false
base_domain           = "" # derives openclaw.<base>, hermes.<base>, n8n.<base>
openclaw_domain       = ""
hermes_domain         = ""
n8n_domain            = ""
acme_email            = ""

# v1 public-domain auth uses Caddy basic auth.
ui_auth_mode     = "basic"
ui_auth_username = "admin"
ui_auth_password = "" # blank = Terraform auto-generates

# ── Tailscale ────────────────────────────────────────────────────
# Strongly recommended: keeps the dashboard off the public internet.
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Use a reusable key so re-deployments don't require a new key each time.

tailscale_enabled  = true
tailscale_mode     = "sidecar" # sidecar | host
tailscale_auth_key = "tskey-auth-..."

# Optional Meta chief-of-staff models (standard API access).
# model_providers_enabled = ["meta"]
# meta_api_key = "YOUR_META_API_KEY"
# default_model = "meta/muse-spark-1.3"
# fallback_models = ["meta/muse-wonder-1.0"]
# Workspace choices: Codex is required and remains the default.
# workspace_harnesses = ["codex", "claude_code", "muse_code"]
# workspace_claude_release = "2.1.301"
# workspace_muse_release = "1.4.10-R6427.1"

# Independent OpenCode V1 coding harness (requires workspace service).
# Keep codex selected; other optional harnesses can coexist.
# workspace_harnesses = ["codex", "opencode"]
# workspace_opencode_release = "1.19.3"
# workspace_opencode_model = "huggingface/moonshotai/Kimi-K3:baseten" # required explicit HF choice
# Other reviewed choices: huggingface/meta-models/Muse-Spark-Open-816B-A42B:baseten
# or huggingface/deepseek-ai/DeepSeek-V4.1-Flash:baseten. Independent of personal-agent models.
# Authenticate separately in the workspace; existing user config is preserved.

# Hugging Face hosted personal-agent inference (optional; no coding harness change).
# See docs/huggingface-integration.md for reviewed routes, account gates and tools.
huggingface_api_key = "" # Existing permitted token only; never infer free usage.
# model_providers_enabled = ["huggingface"]
# default_model = "huggingface/moonshotai/Kimi-K3:baseten"
# fallback_models = ["huggingface/meta-models/Muse-Spark-Open-816B-A42B:baseten", "huggingface/deepseek-ai/DeepSeek-V4.1-Flash:baseten"]
